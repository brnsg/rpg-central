# RPG Central - Configurações de Ambiente

# 1. Banco de Dados PostgreSQL (Neon.tech)
# Obtenha sua Connection String gratuita em: https://neon.tech
# Formato: postgresql://[usuario]:[senha]@[host-do-neon].neon.tech/[banco]?sslmode=require
# Deixe em branco se quiser rodar localmente com SQLite (fallback automático)
DATABASE_URL=

# 2. Google Gemini API (Inteligência Artificial)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Porta do Servidor (opcional, padrão 3000 ou injetada pelo Render)
PORT=3000
